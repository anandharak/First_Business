# MongoDB Connection URI (Local or MongoDB Atlas)
# For Local: mongodb://127.0.0.1:27017/shop_platform
# For Vercel/Production: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shop_platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shop_platform

# Server Port (used for local backend server)
PORT=5000
